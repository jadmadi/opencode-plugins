#!/usr/bin/env sh
# Install the pre-push hook that runs script/test before a push.
set -eu
cd "$(dirname "$0")/.."
root=$(git rev-parse --show-toplevel)
hook="$root/.git/hooks/pre-push"
cat > "$hook" <<'EOF'
#!/bin/sh
# Installed by script/install-hooks. Runs the map checks before a push.
exec "$(git rev-parse --show-toplevel)/script/test"
EOF
chmod +x "$hook"
echo "installed $hook"
